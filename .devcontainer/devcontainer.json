{
  "name": "AIAP Labs",
  // Python base rather than a lean single-language image, because the labs
  // are not one language: rag/mcp/agents/security/cicd are Python, and
  // cli-agents installs terminal coding agents from npm, which need Node 22
  // or newer. One image covers every lab; per-lab devcontainers would
  // fragment the student's single copy.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    // The first thing a student sees: the guide, with the week table and the
    // route through the labs.
    "codespaces": { "openFiles": ["lectures-and-labs/README.md"] },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.copilot-chat",
        "marp-team.marp-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        // A student opens this repo to do the labs, so the explorer shows the
        // labs and the things the labs tell them to create — and nothing else.
        // Two rules govern what may go in here:
        //   1. files.exclude also removes a path from quick-open and from
        //      search, so anything a lab asks the student to CREATE or EDIT
        //      must stay visible. .github stays for that reason: cicd builds
        //      ci.yml and review.yml in it, and security adds security.yml.
        //      AGENTS.md stays because cli-agents teaches that exact format
        //      and the root file is the worked example.
        //   2. Patterns are workspace-root-relative, so a bare name hides only
        //      the root copy. That matters: lectures-and-labs/week03/prompting_lab/scripts
        //      exists, so
        //      "**/scripts" would hide part of a lab. Bare names below are
        //      deliberate, not shorthand for "**/".
        "files.exclude": {
          "**/.devcontainer": true,
          "**/.vscode": true,
          "**/.gitignore": true,
          "**/.gitattributes": true,
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "build": true,
          "docs": true,
          "project": true,
          "practice": true,
          "scripts": true,
          "themes": true,
          "package.json": true,
          "package-lock.json": true,
          "CLAUDE.md": true,
          "CLAUDE.local.md": true
        }
      }
    }
  },
  // Each lab installs its own requirements (the README's first step), so
  // creating the container stays fast and a heavy lab such as rag does not
  // slow down every other week. pytest is the one thing every lab's tests
  // assume, so it is installed once here.
  "postCreateCommand": "python -m pip install --quiet --upgrade pip pytest && python --version && node --version",
  // Each time the workspace is opened: first, if main is checked out, take
  // any commit the nightly course-sync workflow pushed to your repo overnight
  // (fast-forward only, so it can never merge, rebase or touch your own work;
  // on another branch, or if it cannot fast-forward, it does nothing), then
  // refresh the lectures, lab
  // instructions, this configuration and any lab starter file you have not
  // changed from the module repo. A file you edited or created is always
  // kept, and it exits quietly (never non-zero) so it can't stop the
  // Codespace starting if you are offline. In the module's own repo the
  // sync does nothing.
  "postAttachCommand": "([ \"$(git branch --show-current)\" = main ] && git pull --ff-only --quiet origin main || true) && bash scripts/update-course-content.sh --quiet || true"
}
