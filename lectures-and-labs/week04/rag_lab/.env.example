# Copy this file to .env and fill in LLM_API_KEY. .env is gitignored.
#
# Only the generation half of the lab (sections 3 to 5) uses these; chunking,
# embeddings and retrieval need no key at all.
#
# The defaults use the Gemini API's free tier through its OpenAI-compatible
# endpoint. Get a key at https://aistudio.google.com/apikey -- a Google
# account is all you need. On the free tier Google may use what you send to
# improve its products, so send it nothing personal; the lab's corpus is fine.
#
# Any other OpenAI-compatible provider works too: change the base URL and the
# model name here, and nothing in the code.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
